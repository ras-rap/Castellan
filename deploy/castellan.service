[Unit]
Description=castellan
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=opencode
WorkingDirectory=/opt/castellan
ExecStart=/home/opencode/.bun/bin/bun run src/main.ts
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=JEV_MODE=shadow
# .env supplies DISCORD_TOKEN, BOT_CLIENT_ID, OWNER_ID
EnvironmentFile=/opt/castellan/.env
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
